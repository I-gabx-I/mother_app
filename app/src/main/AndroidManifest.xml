<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Fase 03: solo para tomar la foto de la pieza. Nada de almacenamiento:
         la foto se guarda en filesDir, no en galería/MediaStore. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Fase 14 (D-062): sin copia automática de Android. Los datos son de la usuaria y se respaldan SOLO
         con el archivo que ella misma guarda desde «Respaldo»; una copia en la nube de Google que no controla
         (y que restaura sola, sin avisar, sobre una base distinta) es peor que ninguna. -->
    <application
        android:name=".JoyeriaApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MotherApp">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.MotherApp"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Fase 12: compartir las imágenes del catálogo. Solo expone
             cache/catalog/ (ver res/xml/file_paths.xml). No pide ningún
             permiso de Android y no es accesible desde otras apps salvo por
             el permiso temporal de lectura que se le da a la app elegida. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>