<?xml version="1.0" encoding="utf-8"?>
<!-- Fase 12: lo único que se comparte con otras apps son las imágenes del
     catálogo, que viven en cacheDir/catalog/. Nada más. -->
<paths>
    <cache-path
        name="catalog"
        path="catalog/" />
    <!-- Fase 13: el PDF de etiquetas que se comparte. -->
    <cache-path
        name="labels"
        path="labels/" />
    <!-- Fase 14: el respaldo (.zip) y los CSV que se comparten. Se pueden vaciar: son copias de salida. -->
    <cache-path
        name="backups"
        path="backups/" />
</paths>
